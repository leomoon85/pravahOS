<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base frosted dark Aero glass body so wallpaper shines through -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="165"
                android:startColor="#8C0D2644"
                android:centerColor="#A007162B"
                android:endColor="#B8040A14" />
            <stroke
                android:width="1.2dp"
                android:color="#8893D5FF" />
        </shape>
    </item>
    <!-- Top Aero Glass specular reflection glaze -->
    <item android:left="1.5dp" android:right="1.5dp" android:top="1.5dp" android:bottom="90dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="21dp" android:topRightRadius="21dp" android:bottomLeftRadius="8dp" android:bottomRightRadius="8dp" />
            <gradient
                android:angle="270"
                android:startColor="#48FFFFFF"
                android:centerColor="#1AFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
