<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base frosted pearl white Aero glass body so wallpaper shines through -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="165"
                android:startColor="#A8FFFFFF"
                android:centerColor="#8CEAF6FF"
                android:endColor="#9CD8ECFA" />
            <stroke
                android:width="1.2dp"
                android:color="#B3FFFFFF" />
        </shape>
    </item>
    <!-- Top crisp white specular reflection glaze -->
    <item android:left="1.5dp" android:right="1.5dp" android:top="1.5dp" android:bottom="90dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="21dp" android:topRightRadius="21dp" android:bottomLeftRadius="8dp" android:bottomRightRadius="8dp" />
            <gradient
                android:angle="270"
                android:startColor="#88FFFFFF"
                android:endColor="#12FFFFFF" />
        </shape>
    </item>
</layer-list>
