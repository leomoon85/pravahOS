<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="#802B4870"
                android:endColor="#99142236" />
            <stroke
                android:width="1dp"
                android:color="#667DD3FC" />
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="9dp" android:topRightRadius="9dp" />
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
