<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="170"
                android:startColor="#66122E50"
                android:endColor="#99061224" />
            <stroke
                android:width="1dp"
                android:color="#594ADE80" />
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="36dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="13dp" android:topRightRadius="13dp" />
            <gradient
                android:angle="270"
                android:startColor="#2EFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
