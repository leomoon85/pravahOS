# PravahOS Silicon Build Environment & Source Pinning
# Target: Google Pixel 7 ("panther" - Google Tensor G2 / GS201)
# Foundation: Foundation 1 (AOSP GKI Linux 5.10 + Native pravahd + Pravah UI)

export PRAVAH_TARGET_DEVICE="panther"
export PRAVAH_TARGET_SOC="gs201"
export PRAVAH_TARGET_ARCH="arm64"
export PRAVAH_FOUNDATION="foundation-1-aosp-gki"

# Authoritative Kernel Source Tree & Revision
export GKI_KERNEL_MANIFEST_URL="https://android.googlesource.com/kernel/manifest"
export GKI_KERNEL_BRANCH="android-gs-pantah-5.10-android14-qpr3"
export GKI_KERNEL_DEFCONFIG="pantah_defconfig"

# Toolchain Revisions & Binaries
export CLANG_PREBUILT_TAG="r487747c"
export CLANG_VERSION="17.0.2"
export CROSS_COMPILE="aarch64-linux-gnu-"
export ARCH="arm64"

# AOSP Device & Vendor Trees
export AOSP_REVISION="android-14.0.0_r55"
export AOSP_BUILD_ID="UQ1A.240205.002"
export AOSP_DEVICE_TREE="device/google/pantah"
export AOSP_KERNEL_DIR="device/google/pantah-kernel"

# Boot Partition Geometry (Pixel 7 v4)
export BOOT_PAGE_SIZE="4096"
export BOOT_HEADER_VERSION="4"
export BOOT_CMDLINE="console=ttySAC0,115200 earlycon=exynos4210,0x10a00000 init=/system/bin/pravahd pravah.titan_m2=1"

# AVB 2.0 Security & Rollback Counter
export AVB_ALGORITHM="SHA256_RSA4096"
export AVB_ROLLBACK_INDEX="1"
export AVB_CUSTOM_KEY_NAME="pravah_avb_custom_key.bin"
