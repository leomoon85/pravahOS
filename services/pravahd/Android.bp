cc_binary {
    name: "pravahd",
    srcs: [
        "pravahd.c",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-O2",
        "-DPRAVAH_PLATFORM_AOSP=1",
    ],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    init_rc: ["pravahd.rc"],
    vendor_available: false,
    recovery_available: true,
}
