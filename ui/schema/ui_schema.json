{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pravahos.dev/schemas/ui_schema.json",
  "title": "PravahOS Declarative UI Component Schema",
  "description": "Defines the declarative structural contract for UI elements generated by the Dynamic Experience Composer (DEC).",
  "type": "object",
  "definitions": {
    "ComponentType": {
      "type": "string",
      "enum": [
        "ROOT_CONTAINER",
        "SURFACE",
        "WORKSPACE",
        "DAG_VIEW",
        "DAG_NODE",
        "DAG_EDGE",
        "APPROVAL_MODAL",
        "AUDIT_VIEWER",
        "INTENT_BAR",
        "AMBIENT_HEADER",
        "METRIC_BADGE",
        "CAPABILITY_CARD",
        "BUTTON",
        "TEXT_BLOCK",
        "INPUT_FIELD",
        "PROGRESS_BAR",
        "DIFF_VIEWER",
        "ALERT_BANNER"
      ]
    },
    "VisualVariant": {
      "type": "string",
      "enum": [
        "default",
        "primary",
        "accent",
        "success",
        "warning",
        "danger",
        "muted",
        "neutral"
      ]
    },
    "SurfaceRole": {
      "type": "string",
      "enum": [
        "ambient",
        "intent",
        "workspace",
        "approval_modal",
        "audit_inspector",
        "system_toast"
      ]
    },
    "NodeStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "WAITING_FOR_APPROVAL",
        "COMPLETED",
        "FAILED",
        "BLOCKED_BY_POLICY",
        "SKIPPED",
        "REJECTED_BY_USER"
      ]
    },
    "ActionTrigger": {
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "payload": { "type": "object" },
        "requiresConfirmation": { "type": "boolean" }
      },
      "required": ["action"]
    },
    "UIElement": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/definitions/ComponentType" },
        "role": { "$ref": "#/definitions/SurfaceRole" },
        "variant": { "$ref": "#/definitions/VisualVariant" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "value": {},
        "status": { "$ref": "#/definitions/NodeStatus" },
        "properties": { "type": "object" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/definitions/ActionTrigger" }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/UIElement" }
        }
      },
      "required": ["id", "type"]
    },
    "ViewComposition": {
      "type": "object",
      "properties": {
        "surfaceId": { "type": "string" },
        "role": { "$ref": "#/definitions/SurfaceRole" },
        "timestamp": { "type": "number" },
        "root": { "$ref": "#/definitions/UIElement" },
        "associatedTaskId": { "type": ["string", "null"] },
        "requiresUserFocus": { "type": "boolean" },
        "metadata": { "type": "object" }
      },
      "required": ["surfaceId", "role", "root", "timestamp"]
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/UIElement" },
    { "$ref": "#/definitions/ViewComposition" }
  ]
}
