// PravahOS Capability Provider Manifest Shard
// Provides standard declarations and exposure for modular capability providers.
{
    capabilities: [
        {
            protocol: "pravah.capability.CapabilityProvider",
        },
    ],
    expose: [
        {
            protocol: "pravah.capability.CapabilityProvider",
            from: "self",
        },
    ],
}
