// PravahOS Specialist Runner Manifest Shard
// Provides standard environment and protocol bindings for specialist neural model runtimes.
// Enforces strict offline isolation (zero network socket routing).
{
    capabilities: [
        {
            protocol: "pravah.inference.SpecialistInference",
        },
    ],
    use: [
        {
            protocol: [
                "fuchsia.inspect.InspectSink",
                "fuchsia.logger.LogSink",
                "fuchsia.sysmem.Allocator",
                "fuchsia.sysmem2.Allocator",
            ],
        },
    ],
    expose: [
        {
            protocol: "pravah.inference.SpecialistInference",
            from: "self",
        },
    ],
}
