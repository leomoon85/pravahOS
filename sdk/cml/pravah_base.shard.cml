// PravahOS Base Component Manifest Shard
// Provides standard diagnostic protocols (logging and inspect) required by all PravahOS components.
{
    use: [
        {
            protocol: [
                "fuchsia.inspect.InspectSink",
                "fuchsia.logger.LogSink",
            ],
        },
    ],
}
