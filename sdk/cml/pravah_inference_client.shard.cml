// PravahOS Inference Client Manifest Shard
// Provides the ModelRegistry and SpecialistInference protocols for components invoking neural inference.
{
    use: [
        {
            protocol: [
                "pravah.inference.ModelRegistry",
                "pravah.inference.SpecialistInference",
            ],
        },
    ],
}
